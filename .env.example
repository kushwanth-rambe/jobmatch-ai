# Copy to .env.local for local development. Never commit real values.
# Server-side only — never prefix these with NEXT_PUBLIC_.

# Required for JobMatch Analysis (Google AI Studio API key).
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=

# Optional: minimal | low | medium | high. Defaults to minimal (tested: same quality as low, lower cost).
GEMINI_THINKING_LEVEL=
